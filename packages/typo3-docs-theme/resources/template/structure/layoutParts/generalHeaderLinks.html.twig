{%- set copySources = getSettings('copy_sources') -%}
{%- set sourceFile = sourceFilename() -%}
<link href="http://purl.org/dc/elements/1.1/" rel="schema.dc">
<link href="{{ getRelativePath('_resources/css/theme.css') }}" rel="stylesheet">
<link href="https://docs.typo3.org/search/" rel="search" title="Search">
{% if (copySources and sourceFile) %}<link href="{{ copyDownload(sourceFile, '_sources/' ~ sourceFile ~ '.txt') }}" rel="alternate" title="reStructuredText source" type="text/x-rst">
{% endif %}<script src="https://cdn.typo3.com/typo3infrastructure/universe/dist/webcomponents-loader.js"></script>
<script src="https://cdn.typo3.com/typo3infrastructure/universe/dist/typo3-universe.js" type="module"></script>
