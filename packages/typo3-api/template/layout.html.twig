<!DOCTYPE html>
{# The frame of a page on docs.typo3.org, from structure/layout.html.twig of
   the theme, with the theme's CSS and JavaScript from the CDN. The content
   inside is still that of phpDocumentor. #}
<html class="no-js" lang="en">
<head>
    <meta charset="utf-8">
    {% block head %}
        <title>{% block title %}{{ include('components/page-title.html.twig') }}{% endblock %}</title>
    {% endblock %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ renderBaseUrlHeader() }}
    <link rel="icon" href="/favicon.ico"/>
    <link href="http://purl.org/dc/elements/1.1/" rel="schema.dc">
    <link href="{{ parameter.typo3_theme_url }}/css/theme.css" rel="stylesheet">
    <link rel="stylesheet" href="css/base.css">
    <link rel="stylesheet" href="css/template.css">
    <link href="https://docs.typo3.org/search/" rel="search" title="Search">
    <script src="https://cdn.typo3.com/typo3infrastructure/universe/dist/webcomponents-loader.js"></script>
    <script src="https://cdn.typo3.com/typo3infrastructure/universe/dist/typo3-universe.js" type="module"></script>
</head>
<body id="top">
{# An issue about the API is one about the documentation of the Core, as
   getReportIssueLink() of the theme writes it for the Core Changelog. #}
{% set pageUrl = 'https://api.typo3.org/' ~ parameter.typo3_version ~ '/' ~ link(node) %}
{% set reportIssueLink = 'https://forge.typo3.org/projects/typo3cms-core/issues/new?issue[category_id]=1004&issue[subject]='
    ~ ('Problem on ' ~ pageUrl)|url_encode
    ~ '&issue[custom_field_values][4]=' ~ (parameter.typo3_version == 'main' ? '15' : parameter.typo3_version|split('.')|first) %}
{% set sourceLink = node is class or node is interface or node is trait or node is enum
    ? parameter.typo3_github_url ~ '/' ~ parameter.typo3_version ~ '/' ~ node.file.path ~ '#L' ~ node.line
    : '' %}
<div class="page">
    {% include 'components/header.html.twig' %}
    <main class="page-main">
        <div class="page-main-inner">
            <div class="page-main-navigation">
                <nav>
                    <div id="toc-collapse">
                        <div aria-label="main navigation" class="toc" role="navigation">
                            {% include 'components/sidebar.html.twig' %}
                        </div>
                        <div class="toc-options d-lg-none">
                            <p class="caption">Options</p>
                            {% include 'components/options-menu.html.twig' %}
                        </div>
                    </div>
                </nav>
            </div>
            <div class="page-main-content">
                <div class="rst-content phpdocumentor">
                    {# The theme styles the headline links and the toggles
                       of the sections only in an article. #}
                    <article class="document phpdocumentor-content" role="main">
                        {% if block('on_this_page') is defined %}
                        <section>
                        {% endif %}
                            {% block content %}{% endblock %}
                        {% if block('on_this_page') is defined %}
                        </section>
                        <section class="phpdocumentor-on-this-page__sidebar">
                            {{ block('on_this_page') }}
                        </section>
                        {% endif %}
                    </article>
                </div>
            </div>
        </div>
    </main>
    {% include 'components/footer.html.twig' %}
</div>

<script src="{{ parameter.typo3_theme_url }}/js/bootstrap.min.js"></script>
<script src="{{ parameter.typo3_theme_url }}/js/theme.min.js"></script>
</body>
</html>
