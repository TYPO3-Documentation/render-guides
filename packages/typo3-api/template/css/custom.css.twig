:root {
    --primary-color-hue: 32;
    --primary-color-saturation: 100%;
    --primary-color: hsl(var(--primary-color-hue), var(--primary-color-saturation), 50%);
    --primary-color-darker: hsl(var(--primary-color-hue), var(--primary-color-saturation), 50%);

    --text-color: hsl(0, 0%, 0%);
    --link-color-primary: var(--text-color);
}

.phpdocumentor-table-of-contents .phpdocumentor-table-of-contents__entry.-private:after {
    mask: url('data:image/svg+xml;utf8,{{ include('icons/private.svg.twig')|trim|raw }}') no-repeat;
}
.phpdocumentor-table-of-contents .phpdocumentor-table-of-contents__entry.-protected:after {
    left: 13px;
    mask: url('data:image/svg+xml;utf8,{{ include('icons/protected.svg.twig')|trim|raw }}') no-repeat;
}

.phpdocumentor-table-of-contents .phpdocumentor-table-of-contents__entry:before {
    mask: transparent url('data:image/svg+xml;utf8,{{ include('icons/method.svg.twig', {'hue': colours.hue(parameter.color|default('phpdocumentor-green'))})|trim|raw }}') no-repeat center center;
    background: var(--primary-color);
}

.phpdocumentor-table-of-contents .phpdocumentor-table-of-contents__entry.-method:before {
    mask-image: url('data:image/svg+xml;utf8,{{ include('icons/method.svg.twig', {'hue': colours.hue(parameter.color|default('phpdocumentor-green'))})|trim|raw }}');
    background: var(--primary-color);
}

.phpdocumentor-table-of-contents .phpdocumentor-table-of-contents__entry.-function:before {
    mask-image: url('data:image/svg+xml;utf8,{{ include('icons/method.svg.twig', {'hue': colours.hue(parameter.color|default('phpdocumentor-green'))})|trim|raw }}');
    background: var(--primary-color);
}

section.phpdocumentor-description {
  margin-top: 0;
}

.phpdocumentor-typo3-documentation summary {
    cursor: pointer;
    font-weight: bold;
}

.phpdocumentor-typo3-documentation__kind {
    font-size: var(--text-xs);
    opacity: .75;
    text-transform: uppercase;
    letter-spacing: .05em;
}

/* A long class name or type has no space to break at. On a phone it
   breaks anywhere rather than make the page scroll sideways. */
.phpdocumentor-content {
    min-width: 0;
    overflow-wrap: anywhere;
}

.phpdocumentor-content abbr {
    white-space: normal;
}

/* "On this page" sticks below the header of the theme, as the menu does,
   and its text starts as far down as that of the menu: the padding of the
   menu (2rem) and the margin of its list (1rem). */
.phpdocumentor-on-this-page__content {
    top: var(--page-header-height);
    height: calc(100vh - var(--page-header-height));
    box-sizing: border-box;
    padding-top: 3rem;
}

/* Extends, implements, and uses below the title: one line each. */
.phpdocumentor-element__relations {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: .25rem 1rem;
}

.phpdocumentor-element__relations dt {
    font-weight: 600;
}

.phpdocumentor-element__relations dt,
.phpdocumentor-element__relations dd {
    margin: 0;
    padding: 0;
}

/* A release of the Changelog groups places; it is no section of its own. */
.phpdocumentor-typo3-documentation__version {
    font-size: 1rem;
    font-weight: 600;
    margin: 1rem 0 .5rem;
}

/* A long default value: its start, and the whole value once opened. */
.phpdocumentor-signature__default-value.-long details {
    display: inline;
}

.phpdocumentor-signature__default-value.-long summary {
    display: inline;
    margin-left: .5em;
    font-family: var(--bs-body-font-family, inherit);
    color: var(--bs-link-color, inherit);
    text-decoration: underline;
    cursor: pointer;
}

.phpdocumentor-signature__default-value.-long details[open] summary {
    display: block;
    margin: .5em 0;
}

.phpdocumentor-signature__default-value.-long:has(details[open]) .phpdocumentor-signature__default-start {
    display: none;
}

.phpdocumentor-signature__default-full {
    display: block;
    white-space: pre-wrap;
}
