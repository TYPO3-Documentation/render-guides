{# The menu of a manual on docs.typo3.org, see structure/navigation/menu.html.twig
   of the theme: the manuals first, then the namespace tree. The versions are
   in the header, the legal links in the footer. #}
<div aria-label="Main navigation" class="main_menu" role="navigation">
    <p class="caption">Documentation</p>
    <ul class="menu-level-1" role="menubar">
        <li role="menuitem"><a href="https://docs.typo3.org/m/typo3/tutorial-getting-started/{{ parameter.typo3_version }}/en-us/">Getting Started</a></li>
        <li role="menuitem"><a href="https://docs.typo3.org/m/typo3/reference-coreapi/{{ parameter.typo3_version }}/en-us/">TYPO3 Explained</a></li>
        <li role="menuitem"><a href="https://docs.typo3.org/c/typo3/cms-core/{{ parameter.typo3_version }}/en-us/">TYPO3 Core Changelog</a></li>
    </ul>
    {% for version in project.versions %}
        {% for toc in version.tableOfContents %}
            {% if toc.name != "Packages" %}
                <p class="caption">Extensions</p>
                {% for root in toc.roots %}
                    {{ toc(root, 'components/menu.html.twig', 1) }}
                {% endfor %}
            {% endif %}
        {% endfor %}
    {% endfor %}
</div>
