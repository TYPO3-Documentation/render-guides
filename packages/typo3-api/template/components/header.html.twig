{# The header of docs.typo3.org, from structure/layoutParts/pageHeader.html.twig
   of the theme. The versions are those of the API rather than those that
   docs.typo3.org knows for the page. #}
<header>
    <div class="page-topbar">
        <div class="page-topbar-inner">
            <typo3-universe active="documentation">
                <div style="display: block; height: 44px; background-color: #313131;"></div>
            </typo3-universe>
        </div>
    </div>
    <div class="page-header">
        <div class="page-header-inner">
            <a class="navbar-brand" href="https://docs.typo3.org/" title="TYPO3 Documentation">
                <span class="navbar-brand-text">
                    <img src="{{ parameter.typo3_theme_url }}/img/typo3-soul.svg" alt="TYPO3" class="navbar-brand-logo" width="29" height="29">
                    <span class="navbar-brand-name">Documentation</span>
                </span>
            </a>
            <div class="header-nav">
                <div class="toc-header">
                    <div class="toc-title">
                        <a class="toc-title-project" href="{{ path('/') }}">TYPO3 API</a>
                    </div>
                    <label for="api-version-select" class="visually-hidden">Select version</label>
                    <select id="api-version-select" class="form-select" onchange="window.location.href = this.value">
                        {% for version, label in {
                            'main': 'main/v15-dev',
                            '14.3': 'v14.3 LTS',
                            '13.4': 'v13.4 LTS',
                            '12.4': 'v12.4 eLTS',
                            '11.5': 'v11.5 eLTS',
                        } %}
                            <option value="https://api.typo3.org/{{ version }}/{{ link(node) }}"{% if version == parameter.typo3_version %} selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="header-actions">
                <button id="search-toggle" class="btn btn-light d-lg-none" type="button"
                        aria-label="Search" aria-keyshortcuts="Control+K Meta+K">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                </button>
                <button id="toc-toggle" class="btn btn-light d-lg-none" type="button"
                        aria-label="Menu" aria-expanded="false" aria-controls="toc-collapse">
                    <i class="fa-solid fa-bars" aria-hidden="true"></i>
                </button>
                <all-documentations-menu></all-documentations-menu>
                <search role="search" aria-label="Site search">
                    <select id="searchscope" hidden aria-hidden="true">
                        <option value="">Search all</option>
                    </select>
                    <div id="global-search-root"></div>
                </search>
                <button id="options-toggle" class="btn btn-light" type="button"
                        aria-controls="options-panel" aria-expanded="false" popovertarget="options-panel">
                    <i class="fa-solid fa-gear" aria-hidden="true"></i>
                    <span class="visually-hidden">Options</span>
                </button>
                <div id="options-panel" class="shadow p-3" popover>
                    <h6 class="dropdown-header text-muted text-uppercase small mb-2">Options</h6>
                    {% include 'components/options-menu.html.twig' %}
                </div>
            </div>
        </div>
    </div>
</header>
