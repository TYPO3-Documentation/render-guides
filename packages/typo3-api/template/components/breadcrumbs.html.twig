{# The breadcrumb of docs.typo3.org, see structure/document.html.twig and
   body/menu/breadcrumb.html.twig of the theme: the start page of the API,
   the namespaces, and the page itself. Feedback and the source of a type are
   linked on the right, as a manual links them for its page. #}
{% set breadcrumbs = usesNamespaces ? breadcrumbs(node) : packages(node) %}
<nav aria-label="breadcrumbs navigation" class="breadcrumb-bar" role="navigation">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('/') }}">TYPO3 API</a></li>
        {% for breadcrumb in breadcrumbs %}
            <li class="breadcrumb-item"><a href="{{ link(breadcrumb) }}">{{ breadcrumb.name }}</a></li>
        {% endfor %}
        <li aria-current="page" class="breadcrumb-item active">{{ node.name }}</li>
    </ol>
    <div class="breadcrumb-additions">
        <a class="btn btn-sm btn-light" href="{{ reportIssueLink }}" id="btnReportIssue" rel="nofollow noopener" target="_blank">
            <span class="btn-icon"><i class="fa-solid fa-comment-dots"></i></span>
            <span class="btn-text">Give feedback</span>
        </a>
        {% if sourceLink %}
            <a class="btn btn-sm btn-secondary" href="{{ sourceLink }}"
               rel="nofollow noopener" target="_blank" title="View {{ node.file.name }}:{{ node.line }} on GitHub">
                <span class="btn-icon"><span class="fa-brands fa-github"></span></span>
                <span class="btn-text">View on GitHub</span>
            </a>
        {% endif %}
    </div>
</nav>
