{# A deprecation as the directive "deprecated" of a manual shows it, see
   body/version-change.html.twig of the theme. #}
{% if node.deprecated %}
    {% for deprecation in node.deprecations %}
        <div class="versionchange deprecated">
            <p class="versionmodified">
                <span class="versionicon"><i class="fa-solid fa-ban"></i></span>
                Deprecated{% if deprecation.version %} since version {{ deprecation.version }}{% endif %}
            </p>
            <article>
                {{ deprecation.description|description|markdown }}
            </article>
        </div>
    {% endfor %}
{% endif %}
